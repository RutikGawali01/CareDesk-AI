# ========================================================
# CareDesk-AI Environment Configuration Template (.env.example)
# ========================================================
# Copy this file to .env and replace placeholder values with your configuration.
# Do NOT commit actual secrets or credentials to source control.

# Ports (Host Mappings)
BACKEND_PORT=5001
FRONTEND_PORT=5173

# Frontend Build Configuration
# In browser, frontend calls this backend URL. Defaults to http://localhost:5001
VITE_API_URL=http://localhost:5001

# Backend Server Configuration
PORT=5001
NODE_ENV=production

# Database Connection (PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@hostname:5432/caredesk?sslmode=require"

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:80

# AI Configuration (Optional / Integrations)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
AI_BOOKING_ENABLED=false
AI_APPOINTMENT_CHANGES_ENABLED=false

# Meta WhatsApp Webhook Configuration (Optional / Integrations)
WHATSAPP_CLINIC_MAP={"1417503314772648":1}
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
META_APP_SECRET=your_meta_app_secret
